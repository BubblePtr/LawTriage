VITE_LIVEKIT_URL=

# Server-side LiveKit Agent worker. Do not prefix API key/secret with VITE_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PARTICIPANT_TOKEN_TTL_SECONDS=1800
# Optional. Leave empty for automatic room dispatch during local development.
LIVEKIT_AGENT_NAME=

# Server-side LiveKit Agent provider. Leave empty to reuse VITE_AGENT_PROVIDER
# and auto-select volcengine when ARK_* + VOLC_* keys exist.
AGENT_PROVIDER=

# Optional LiveKit Inference fallback. Used only when AGENT_PROVIDER=inference.
LIVEKIT_AGENT_STT_MODEL=deepgram/nova-3:zh
LIVEKIT_AGENT_LLM_MODEL=openai/gpt-4.1-mini
LIVEKIT_AGENT_TTS_MODEL=cartesia/sonic-2
LIVEKIT_AGENT_TTS_VOICE=

# Agent provider: dev | openai | volcengine
VITE_AGENT_PROVIDER=dev

# Server-side only. Do not prefix API keys with VITE_.
OPENAI_API_KEY=
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe
OPENAI_LLM_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Volcengine Ark LLM.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=

# Volcengine Seed ASR.
# Real-time ASR uses the streaming WebSocket binary protocol.
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_STREAM_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# LiveKit Agent worker finalizes one Volcengine ASR turn after this much trailing silence.
LIVEKIT_AGENT_ASR_TURN_SILENCE_MS=1200

# Volcengine Seed TTS.
VOLC_TTS_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE_TYPE=
VOLC_TTS_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# Volcengine TTS is non-streaming, so keep first chunks short and allow a wider first-frame window.
LIVEKIT_AGENT_TTS_CHUNK_MAX_CHARS=80
LIVEKIT_AGENT_TTS_READ_IDLE_TIMEOUT_MS=30000
LIVEKIT_AGENT_FORWARD_AUDIO_IDLE_TIMEOUT_MS=30000
